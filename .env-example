# Mandatory
DISCORD_TOKEN=

# Optional - Only needed if you want to use the Spotify Source
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=

# Optional - Database. Defaults to an embedded H2 file database stored in /data.
# To use postgres instead, uncomment and fill the following:
#DB_KIND=postgresql
#DB_URL=jdbc:postgresql://host:5432/lagit
#DB_USERNAME=
#DB_PASSWORD=
